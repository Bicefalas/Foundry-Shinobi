<div class="martial-editor">
    <h1>{{localize "Combat Styles"}}</h1>

    {{#if editable}}
    <prose-mirror name="system.martial-combat.combat-styles" button="true" editable="{{editable}}" toggled="false"
        rollData="rollData" value="{{system.martial-combat.combat-styles}}">
        {{{system.martial-combat.combat-styles}}}
    </prose-mirror>
    {{else}}
    {{{system.martial-combat.combat-styles}}}
    {{/if}}


    <h1>{{localize "Martial Arts"}}</h1>

    {{#if editable}}
    <prose-mirror name="system.martial-combat.martial-arts" button="true" editable="{{editable}}" toggled="false"
        rollData="rollData" value="{{system.martial-combat.martial-arts}}">
        {{{system.martial-combat.martial-arts}}}
    </prose-mirror>
    {{else}}
    {{{system.martial-combat.martial-arts}}}
    {{/if}}


    <h1>{{localize "Habitual Combat Move"}}</h1>
    {{#if editable}}
    <prose-mirror name="system.martial-combat.combat-move" button="true" editable="{{editable}}" toggled="false"
        rollData="rollData" value="{{system.martial-combat.combat-move}}">
        {{{system.martial-combat.combat-move}}}
    </prose-mirror>
    {{else}}
    {{{system.martial-combat.combat-move}}}
    {{/if}}

</div>