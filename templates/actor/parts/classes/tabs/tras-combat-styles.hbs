<div class="grid grid-4col">
    <div class="resource-content">
        <div class="resource-field">
            {{#ifCond "warrior" '==' system.class.value}}
            {{> 'systems/shinobi/templates/actor/parts/classes/resources/warrior.hbs'}}
            {{/ifCond}}
        </div>
    </div>
    <div class="class-editor grid-span-3">
        <h1>{{localize "Trascendental Combat Styles"}}</h1>

        {{#if editable}}
        <prose-mirror name="system.tras-combat-styles" button="true" editable="{{editable}}" toggled="false"
            rollData="rollData" value="{{system.tras-combat-styles}}">
            {{{system.tras-combat-styles}}}
        </prose-mirror>
        {{else}}
        {{{system.tras-combat-styles}}}
        {{/if}}
    </div>
</div>
<div class="resource-chart">
    <h1>{{localize "Trascendental Combat Techniques"}}</h1>
    <ol class='items-list'>
        <li class='item grid grid-4col items-header'>
            <div class='item-name'>{{localize 'Name'}}</div>
            <div class='item-features'>{{localize 'Description'}}</div>
            <div class='item-features'>{{localize 'Cost'}}</div>
            <div class='item-controls'>{{localize 'Erase'}}</div>
        </li>
        {{#each technique as |item id|}}
        <li class='item draggable grid grid-4col' data-item-id='{{item._id}}'>
            <div class='item-name item-control item-edit' data-action='editItem'>
                <div class='item-image'>
                    <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' />
                </div>
                <h4>{{localize item.name}}</h4>
            </div>
            <div class='item-features'>
                <h4>{{system.description}}</h4>
            </div>
            <div class='item-features'>
                <h4>{{system.cost}}</h4>
            </div>
            <div class='item-controls'>
                <a class='item-control item-delete' data-action='deleteItem' title='{{localize "DOCUMENT.Delete" type=' Technique'}}'>
                    <i class='fas fa-trash'></i>
                </a>
            </div>
        </li>
        {{/each}}
    </ol>
</div>