<div class="shinobi-sheet item-form flexcol">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-action="editImage" data-edit="img" title="{{item.name}}" />
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Name" /></h1>
      <div class="grid grid-3col">
        <div class="resource">
          <label class="resource-label">{{localize "Quantity"}}</label>
          <input type="text" name="system.quantity" value="{{system.quantity}}" data-dtype="Number" />
        </div>
        <div class="resource">
          <label class="resource-label">{{localize "Cost"}}</label>
          <input type="text" name="system.cost" value="{{system.cost}}" data-dtype="Number" />
        </div>
        <div class="resource">
          <label class="resource-label">{{localize "Rarity"}}</label>
          <div class="item-field">
            <select class="select-field" name="system.rarity.value">
              {{#selectOptions system.rarities selected=system.rarity.value}}
              {{/selectOptions}}
            </select>
          </div>
        </div>
      </div>
    </div>
  </header>
  <section class="sheet-body item-body">
    {{!-- Description Tab --}}
    <div class="description-header flex-group-center">
      <h3 class="description-name">{{localize "Description"}}</h3>
    </div>
    <div>
      {{#if editable}}
      <prose-mirror name="system.description" button="true" editable="{{editable}}" toggled="false" rollData="rollData"
        value="{{system.description}}">
        {{{system.description}}}
      </prose-mirror>
      {{else}}
      {{{system.description}}}
      {{/if}}
    </div>
  </section>
</div>