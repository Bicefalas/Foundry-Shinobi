<div class="grid grid-2col">
    <div class="resource">
        <label class="resource-label">{{localize "Type"}}</label>
        <div class="item-field">
            <select class="select-field" name="system.type.value">
                {{#selectOptions system.types selected=system.type.value}}
                {{/selectOptions}}
            </select>
        </div>
    </div>
    <div class="resource">
        <label class="resource-label">{{localize "Damage"}}</label>
        <input type="number" name="system.damage" value="{{system.damage}}" data-dtype="Number" />
    </div>
    {{#ifCond "vayutec" '==' system.type.value}}
    <div class="resource">
        <label class="resource-label">{{localize "Charge per Turn"}}</label>
        <input type="number" name="system.chargePerTurn" value="{{system.chargePerTurn}}" data-dtype="Number" />
    </div>
    <div class="resource">
        <label class="resource-label">{{localize "Max Charge"}}</label>
        <input type="number" name="system.maxCharge" value="{{system.maxCharge}}" data-dtype="Number" />
    </div>
    <div class="resource">
        <label class="resource-label">{{localize "Max Capacity"}}</label>
        <input type="number" name="system.capacity" value="{{system.capacity}}" data-dtype="Number" />
    </div>
    {{/ifCond}}
    <div class="resource">
        <label class="resource-label">{{localize "Initiative"}}</label>
        <input type="number" name="system.initiative" value="{{system.initiative}}" data-dtype="Number" />
    </div>
    <div class="resource">
        <label class="resource-label">{{localize "Required Strength 1 Hand"}}</label>
        <input type="number" name="system.requiredStrength1H" value="{{system.requiredStrength1H}}"
            data-dtype="Number" />
    </div>
    <div class="resource">
        <label class="resource-label">{{localize "Required Strength 2 Hands"}}</label>
        <input type="number" name="system.requiredStrength2H" value="{{system.requiredStrength2H}}"
            data-dtype="Number" />
    </div>
    <div class="resource">
        <label class="resource-label">{{localize "Size"}}</label>
        <input type="text" name="system.size" value="{{system.size}}" data-dtype="text" />
    </div>
    <div class="resource">
        <label class="resource-label">{{localize "Quality"}}</label>
        <input type="number" name="system.quality" value="{{system.quality}}" data-dtype="Number" />
    </div>
    {{#ifCond "ranged" '==' system.type.value}}
    <div class="resource">
        <label class="resource-label">{{localize "Range"}}</label>
        <input type="number" name="system.range" value="{{system.range}}" data-dtype="Number" />
    </div>
    <div class="resource">
        <label class="resource-label">{{localize "Reload"}}</label>
        <input type="number" name="system.reload" value="{{system.reload}}" data-dtype="Number" />
    </div>
    {{/ifCond}}
    {{#ifCond "vayutec" '==' system.type.value}}
    <div class="resource">
        <label class="resource-label">{{localize "Range"}}</label>
        <input type="number" name="system.range" value="{{system.range}}" data-dtype="Number" />
    </div>
    <div class="resource">
        <label class="resource-label">{{localize "Reload"}}</label>
        <input type="number" name="system.reload" value="{{system.reload}}" data-dtype="Number" />
    </div>
    {{/ifCond}}
</div>
<div class="resource">
    <label class="resource-label">{{localize "Damage chart"}}</label>
    <div class="resource-chart grid grid-10col">
        <div>
            <label class="resource-label">{{localize "Difference"}}</label>
            <label class="resource-label">{{localize "Damage"}}</label>
            <label class="resource-label">{{localize "Percentage"}}</label>
        </div>
        <div class="resource-box">
            <label class="resource-label-light damage">4-5</label>
            <label class="resource-label damage">{{#Math 0.25 "*" system.damage}}{{/Math}}</label>
            <label class="resource-label-light damage">25%</label>
        </div>
        <div class="resource-box">
            <label class="resource-label-light damage">6-8</label>
            <label class="resource-label damage">{{#Math 0.5 "*" system.damage}}{{/Math}}</label>
            <label class="resource-label-light damage">50%</label>
        </div>
        <div class="resource-box">
            <label class="resource-label-light damage">9-10</label>
            <label class="resource-label damage">{{#Math 0.75 "*" system.damage}}{{/Math}}</label>
            <label class="resource-label-light damage">75%</label>
        </div>
        <div class="resource-box">
            <label class="resource-label-light damage">11-13</label>
            <label class="resource-label damage">{{#Math 1 "*" system.damage}}{{/Math}}</label>
            <label class="resource-label-light damage">100%</label>
        </div>
        <div class="resource-box">
            <label class="resource-label-light damage">14-18</label>
            <label class="resource-label damage">{{#Math 1.5 "*" system.damage}}{{/Math}}</label>
            <label class="resource-label-light damage">150%</label>
        </div>
        <div class="resource-box">
            <label class="resource-label-light damage">19-23</label>
            <label class="resource-label damage">{{#Math 2 "*" system.damage}}{{/Math}}</label>
            <label class="resource-label-light damage">200%</label>
        </div>
        <div class="resource-box">
            <label class="resource-label-light damage">24-29</label>
            <label class="resource-label damage">{{#Math 3 "*" system.damage}}{{/Math}}</label>
            <label class="resource-label-light damage">300%</label>
        </div>
        <div class="resource-box">
            <label class="resource-label-light damage">30-36</label>
            <label class="resource-label damage">{{#Math 4 "*" system.damage}}{{/Math}}</label>
            <label class="resource-label-light damage">400%</label>
        </div>
        <div class="resource-box">
            <label class="resource-label-light damage">37-...</label>
            <label class="resource-label damage">{{#Math 6 "*" system.damage}}{{/Math}}</label>
            <label class="resource-label-light damage">600%</label>
        </div>
    </div>
</div>

<br>
<div class="resource">
    <label class="resource-label">{{localize "Properties"}}</label>

    {{#if editable}}
    <prose-mirror name="system.special" button="true" editable="{{editable}}" toggled="false" rollData="rollData"
        value="{{system.special}}">
        {{{system.special}}}
    </prose-mirror>
    {{else}}
    {{{system.special}}}
    {{/if}}
</div>