<div class="shinobi-sheet item-form flexcol">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-action="editImage" data-edit="img" title="{{item.name}}" />
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Name" /></h1>
      <div class="grid grid-2col">
        <div class="resource">
          <label class="resource-label">{{localize "Cost"}}</label>
          <input type="text" name="system.cost" value="{{system.cost}}" data-dtype="text" />
        </div>
        <div class="resource">
          <label class="resource-label">{{localize "Rarity"}}</label>
          <select class="select-field" name="system.rarity.value">
            {{#selectOptions system.rarities selected=system.rarity.value}}
            {{/selectOptions}}
          </select>
        </div>
      </div>
    </div>
  </header>
  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item {{tabs.[attributes].cssClass}}" data-action="tab" data-group="primary" data-tab="attributes">{{localize "Attributes"}}</a>
    <a class="item {{tabs.[descriptions].cssClass}}" data-action="tab" data-group="primary" data-tab="descriptions">{{localize "Description"}}</a>
  </nav>
  {{!-- Sheet Body --}}
  <section class="sheet-body item-body">
    {{!-- Attributes Tab --}}
    <div class="tab attributes {{tabs.[attributes].cssClass}}" data-group="primary" data-tab="attributes">
      {{> 'systems/shinobi/templates/item/parts/item-armors-attributes.hbs'}}
    </div>
    {{!-- Description Tab --}}
    <div class="tab descriptions {{tabs.[descriptions].cssClass}}" data-group="primary" data-tab="descriptions">

      {{#if editable}}
      <prose-mirror name="system.description" button="true" editable="{{editable}}" toggled="false" rollData="rollData"
        value="{{system.description}}">
        {{{system.description}}}
      </prose-mirror>
      {{else}}
      {{{system.description}}}
      {{/if}}
    </div>
  </section>
</div>
